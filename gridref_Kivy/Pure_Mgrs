"""
Pure-Python WGS84 lat/lon -> UTM -> MGRS converter.

No C extensions, no numpy. This exists so the Android build doesn't need to
cross-compile the 'mgrs' / 'pyproj' packages (which are common Buildozer
failure points on Android). Implements the standard Transverse Mercator
projection formulas (Karney / Snyder), same approach used by most
JS/Python MGRS libraries.

Provides a drop-in-compatible `MGRS` class with a `toMGRS(lat, lon,
MGRSPrecision=5)` method, matching the interface of the `mgrs` PyPI package
closely enough for this app's needs.
"""

import math

# WGS84 ellipsoid constants
_A = 6378137.0
_F = 1 / 298.257223563
_K0 = 0.9996
_E = math.sqrt(_F * (2 - _F))
_E2 = _E * _E
_E4 = _E2 * _E2
_E6 = _E2 * _E4
_E1 = (1 - math.sqrt(1 - _E2)) / (1 + math.sqrt(1 - _E2))

_LATITUDE_BANDS = "CDEFGHJKLMNPQRSTUVWXX"  # X repeated: 72-84 covered by X (extended band)

_UTM_100K_SETS = [
    "ABCDEFGH",
    "JKLMNPQR",
    "STUVWXYZ",
]

# columns/rows used for 100km square identification (skips I, O)
_SET_ORIGIN_COLUMN_LETTERS = "AJS"
_SET_ORIGIN_ROW_LETTERS = "AFAFAF"  # cycles per set, standard MGRS scheme


def _deg2rad(d):
    return d * math.pi / 180.0


def _latitude_band(lat_deg):
    if lat_deg >= 84:
        return "X"
    if lat_deg < -80:
        return "A"  # polar - not really supported below, but avoid crash
    idx = int((lat_deg + 80) / 8)
    idx = max(0, min(idx, len(_LATITUDE_BANDS) - 1))
    return _LATITUDE_BANDS[idx]


def _utm_zone(lat_deg, lon_deg):
    zone = int((lon_deg + 180) / 6) + 1

    # Norway/Svalbard exceptions (standard UTM special cases)
    if 56 <= lat_deg < 64 and 3 <= lon_deg < 12:
        zone = 32
    if 72 <= lat_deg < 84:
        if 0 <= lon_deg < 9:
            zone = 31
        elif 9 <= lon_deg < 21:
            zone = 33
        elif 21 <= lon_deg < 33:
            zone = 35
        elif 33 <= lon_deg < 42:
            zone = 37

    return zone


def _ll_to_utm(lat_deg, lon_deg):
    """Convert lat/lon (degrees, WGS84) to UTM zone, hemisphere, easting, northing."""
    lat = _deg2rad(lat_deg)
    zone = _utm_zone(lat_deg, lon_deg)
    lon_origin = (zone - 1) * 6 - 180 + 3
    lon_origin_rad = _deg2rad(lon_origin)
    lon = _deg2rad(lon_deg)

    N = _A / math.sqrt(1 - _E2 * math.sin(lat) ** 2)
    T = math.tan(lat) ** 2
    C = (_E2 / (1 - _E2)) * math.cos(lat) ** 2
    A_ = math.cos(lat) * (lon - lon_origin_rad)

    M = _A * (
        (1 - _E2 / 4 - 3 * _E4 / 64 - 5 * _E6 / 256) * lat
        - (3 * _E2 / 8 + 3 * _E4 / 32 + 45 * _E6 / 1024) * math.sin(2 * lat)
        + (15 * _E4 / 256 + 45 * _E6 / 1024) * math.sin(4 * lat)
        - (35 * _E6 / 3072) * math.sin(6 * lat)
    )

    easting = (
        _K0
        * N
        * (
            A_
            + (1 - T + C) * A_ ** 3 / 6
            + (5 - 18 * T + T ** 2 + 72 * C - 58 * (_E2 / (1 - _E2))) * A_ ** 5 / 120
        )
        + 500000.0
    )

    northing = _K0 * (
        M
        + N
        * math.tan(lat)
        * (
            A_ ** 2 / 2
            + (5 - T + 9 * C + 4 * C ** 2) * A_ ** 4 / 24
            + (61 - 58 * T + T ** 2 + 600 * C - 330 * (_E2 / (1 - _E2))) * A_ ** 6 / 720
        )
    )

    if lat_deg < 0:
        northing += 10000000.0  # southern hemisphere offset

    hemisphere = "N" if lat_deg >= 0 else "S"
    return zone, hemisphere, easting, northing


def _e100k_letter(zone, easting):
    set_num = ((zone - 1) % 3)
    col = int(easting / 100000)
    letters = _UTM_100K_SETS[set_num]
    idx = col - 1
    idx = max(0, min(idx, len(letters) - 1))
    return letters[idx]


def _n100k_letter(zone, northing):
    row_letters_even = "ABCDEFGHJKLMNPQRSTUV"
    row_letters_odd = "FGHJKLMNPQRSTUVABCDE"
    row = int(northing / 100000) % 20
    if zone % 2 == 0:
        return row_letters_odd[row]
    return row_letters_even[row]


def _to_mgrs_precision(easting, northing, precision):
    """Truncate easting/northing (within the 100km square, in meters) to `precision` digits."""
    e_in_square = int(easting) % 100000
    n_in_square = int(northing) % 100000

    # scale to the desired digit count (5 = 1m, 4 = 10m, 3 = 100m)
    digits = precision
    divisor = 10 ** (5 - digits)
    e_str = str(int(e_in_square / divisor)).zfill(digits)
    n_str = str(int(n_in_square / divisor)).zfill(digits)
    return e_str, n_str


class MGRS:
    """Drop-in-ish replacement for `mgrs.MGRS()` from the `mgrs` PyPI package."""

    def toMGRS(self, lat, lon, MGRSPrecision=5):
        if not (-80.0 <= lat <= 84.0):
            # Polar regions use UPS, not UTM/MGRS grid zones - out of scope here.
            raise ValueError(
                "Latitude outside supported UTM/MGRS range (-80 to 84 degrees)"
            )

        zone, hemisphere, easting, northing = _ll_to_utm(lat, lon)
        band = _latitude_band(lat)
        e_letter = _e100k_letter(zone, easting)
        n_letter = _n100k_letter(zone, northing)
        e_str, n_str = _to_mgrs_precision(easting, northing, MGRSPrecision)

        return f"{zone}{band}{e_letter}{n_letter}{e_str}{n_str}"
